RSC_TOKEN=change-me
RSC_DB=./data/rsc.db
RSC_PORT=8787
RSC_POLL_SECONDS=60

# Required. Generate with: openssl rand -hex 32
RSC_AUTH_SECRET=change-me

# Optional — defaults shown. Must match the web app's public origin, or
# every session-carrying auth request 403s (better-auth CSRF check).
# RSC_WEB_ORIGIN=http://localhost:5173

# Optional — default shown. Idle anonymous accounts are swept hourly once
# they exceed this many days.
# RSC_ANON_TTL_DAYS=7

# v2 source registry — flipping this to `on` runs the ONE-WAY migration cutover
# (preflight + conversion, in one transaction before core listens). After the
# conversion marker commits, `off` is refused at startup; the only way back is
# the pre-flip backup. Read "Source model v2" in
# docs/superpowers/documentation/RUNNING.md and follow the runbook first.
RSC_SOURCE_MODEL_V2=off

# Optional path to the cutover manifest — pre-approves legacy `instance` feeds
# that would otherwise convert as quarantined. Validated by
# `npm run preflight -w core`; schema in RUNNING.md.
# RSC_MIGRATION_MANIFEST=./data/migration-manifest.json
