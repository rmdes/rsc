RSC_TOKEN=change-me
RSC_DB=./data/rsc.db
RSC_PORT=8787
RSC_POLL_SECONDS=60

# Required. Generate with: openssl rand -hex 32
RSC_AUTH_SECRET=change-me

# Optional — defaults shown. Must match the web app's public origin, or
# every session-carrying auth request 403s (better-auth CSRF check).
# RSC_WEB_ORIGIN=http://localhost:5173

# Optional — default shown. Idle anonymous accounts are swept hourly once
# they exceed this many days.
# RSC_ANON_TTL_DAYS=7

# Legacy-to-v2 conversion runs automatically, once, before core listens — no
# flag. Only matters when upgrading an instance that still has a pre-v2
# database; a fresh instance has nothing to convert. Optional path to a
# manifest that pre-approves legacy `instance` feeds that would otherwise
# convert as quarantined. Validated by `npm run preflight -w core`; schema in
# "Legacy data conversion" in docs/superpowers/documentation/RUNNING.md.
# RSC_MIGRATION_MANIFEST=./data/migration-manifest.json
